# Copy this file to outbound/.env and fill it in. NEVER commit .env.
#
# GMAIL_USER: the Gmail / Google Workspace address you send from.
# GMAIL_APP_PASSWORD: an app password, NOT your normal password.
#   Create one at https://myaccount.google.com/apppasswords
#   (requires 2-step verification to be enabled on the account)

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: API port (default 4571)
# PORT=4571
