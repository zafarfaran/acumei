{
  "name": "acumei-outbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local outbound CRM and email automation for Acumei",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
