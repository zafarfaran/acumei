# Workbench live mode (/api/workbench/run). Server-side only: set these in the
# Vercel project's environment variables, never in client code.

# Required for live questions. Without it the page says live mode isn't on yet.
OPENAI_API_KEY=
# Optional: the model to use (default gpt-4.1-mini).
OPENAI_MODEL=

# Daily limits (5 per visitor, WORKBENCH_DAILY_CAP overall). Without Upstash the
# counters are per server instance, which is fine locally but not in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORKBENCH_DAILY_CAP=300

# Local development only: answer live questions with a scripted stand-in model.
# Ignored when VERCEL_ENV is production.
WORKBENCH_FAKE_PROVIDER=
